{
  "schemaVersion": 1,
  "id": "basalt_crusher",
  "version": "${version}",
  "name": "Basalt Crusher",
  "description": "Making basalt useful since 2022!",
  "authors": [
    "GniftyGnome"
  ],
  "contact": {
    "website": "http://www.gnomecraft.net/",
    "repo": "https://github.com/gniftygnome/basalt-crusher"
  },
  "license": "MIT",
  "icon": "assets/basalt_crusher/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "net.gnomecraft.basaltcrusher.BasaltCrusherClient"
    ],
    "main": [
      "net.gnomecraft.basaltcrusher.BasaltCrusher"
    ]
  },
  "mixins": [
    "basalt_crusher.mixins.json",
    {
      "config": "basalt_crusher.client.mixins.json",
      "environment": "client"
    }
  ],
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/client/gui/GuiGraphicsExtractor": ["net/gnomecraft/basaltcrusher/utils/InterfaceStockpile"]
    }
  },
  "depends": {
    "fabricloader": ">=0.15.7",
    "fabric-api": "*",
    "minecraft": ">=26.1-"
  }
}
